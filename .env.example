# Copy this file to .env and adjust values for your local environment.
# Example: cp .env.example .env

# Database connection string for SQLAlchemy.
# SQLite example: sqlite:///heartbeat.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/heartbeat
HEARTBEAT_DB=sqlite:///heartbeat.db

# Local timezone used by health checks, records and log timestamps.
# Defaults to Asia/Shanghai when neither this nor TZ is set.
HEARTBEAT_TZ=Asia/Shanghai

# Port that Flask listens on when running the app directly.
PORT=5100

# Start the background scheduler to run periodic checks.
# Set to 0 to disable it for local debugging.
START_SCHEDULER=1

# Loguru log level (TRACE/DEBUG/INFO/WARNING/ERROR/CRITICAL).
LOG_LEVEL=INFO

# Directory for rotating log files. Local default: logs/; container: /app/logs.
LOG_DIR=logs

# Email alarm (SMTP). Leave SMTP_HOST empty to disable actual sending;
# failed attempts are still recorded on the alarm records page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT=10
