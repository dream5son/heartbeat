# Copy this file to .env and adjust values for your local environment.
# Example: cp .env.example .env

# Database connection string for SQLAlchemy.
# SQLite example: sqlite:///heartbeat.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/heartbeat
HEARTBEAT_DB=sqlite:///heartbeat.db

# Port that Flask listens on when running the app directly.
PORT=5100

# Start the background scheduler to run periodic checks.
# Set to 0 to disable it for local debugging.
START_SCHEDULER=1
